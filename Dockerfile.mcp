FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w -X main.version=1.0.0' -o /downwash ./cmd/downwash
FROM alpine:3.24.0
RUN apk add --no-cache ca-certificates && addgroup -S downwash && adduser -S -G downwash downwash
COPY --from=build /downwash /usr/local/bin/downwash
USER downwash
EXPOSE 8080
ENTRYPOINT ["downwash", "mcp", "--listen", "0.0.0.0:8080"]
